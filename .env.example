# Binance API credentials
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=admin
DB_PASSWORD=your_database_password

# Logging
LOG_LEVEL=INFO

# Trading settings
DEFAULT_PAIR=BTC/USDT
BACKTEST_MODE=false

# Copy this file to .env and replace the placeholder values with your actual API keys and settings